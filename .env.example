# ============================================
# RepoPilot — Environment Configuration
# Copy to .env and fill in your values.
# ============================================

# ---- LLM Provider ----
# Supported providers: deepseek | openai | local
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
# Your API key (DeepSeek, OpenAI, or local LLM)
LLM_API_KEY=your_api_key_here
# Legacy env name (still supported as fallback)
# DEEPSEEK_API_KEY=your_api_key_here

# ---- Agent ----
# AGENT_MODE=full           # full (read+write) | readonly
# REACT_MAX_STEPS=20
# LOG_LEVEL=INFO
# EXECUTION_STATE_DEDUP_ENABLED=false
# MUTATION_FSM_ENABLED=true
# STRUCTURED_TOOL_REJECT_ENABLED=true

# ---- API ----
# API_KEY=                  # optional HTTP API auth
# API_CONFIRM_TIMEOUT_SECONDS=300

# ---- Docker ----
# When running via Docker, set REPO_ROOT=/repo
# to analyze the mounted repository volume.
# REPO_ROOT=/repo
